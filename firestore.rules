rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'nugrohoadmin2012@dev.developer';
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /premium_users/{id} {
      allow get: if true;
      allow list, write: if isAdmin();
    }
  }
}
